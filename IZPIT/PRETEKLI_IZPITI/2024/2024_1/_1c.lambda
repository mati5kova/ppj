-- Church
0' := ^ f x . x ;
1' := ^ f x . f x ;
2' := ^ f x . f (f x) ;
3' := ^ f x . f (f (f x)) ;
4' := ^ f x . f (f (f (f x))) ;
5' := ^ f x . f (f (f (f (f x)))) ;
succ' := ^ n . ^ f x . f (n f x) ;

-- Scott-Church
0 := ^ f x . x ;
1 := ^ f x . f 0 x ;
2 := ^ f x . f 1 (f 0 x) ;
3 := ^ f x . f 2 (f 1 (f 0 x)) ;
4 := ^ f x . f 3 (f 2 (f 1 (f 0 x))) ;
5 := ^ f x . f 4 (f 3 (f 2 (f 1 (f 0 x)))) ;
succ := ^ n . ^ f x . f n (n f x) ;