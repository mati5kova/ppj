```
{ N > 0 }
{ 0 < N in 0 = 0 }
i := 0 ;
{ 0 < N in i = 0 in i < N }
do
    prvic: { 0 < N in i=0 in i < N}      nadaljnje: { 0 < N in i < N }
           { 0 < N in ((i+1)-1) < N }               { 0 < N in ((i+1)-1) < N }
    i := i + 1
           { i - 1 < N }                            { 0 < N in i - 1 < N }
while i < N done
{ i  - 1 < N in ¬(i < N) } =>
{ i = N }
```

